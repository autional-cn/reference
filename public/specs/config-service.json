    "/config/history": {
      "get": {
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "description": "分页查询指定配置项的版本历史（append-only）。",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "tags": [
          "配置服务"
        ],
        "summary": "查询配置历史",
        "parameters": [
          {
            "type": "string",
            "description": "环境命名空间",
            "name": "namespace",
            "in": "query",
            "required": true
          },
          {
            "type": "string",
            "description": "服务名（空=全局默认）",
            "name": "service_name",
            "in": "query"
          },
          {
            "type": "string",
            "description": "配置项 key",
            "name": "data_id",
            "in": "query",
            "required": true
          },
          {
            "type": "integer",
            "description": "页码（默认 1）",
            "name": "page",
            "in": "query"
          },
          {
            "type": "integer",
            "description": "每页数量（默认 20，上限 500；P1-2 服务端归一）",
            "name": "page_size",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "版本历史",
            "schema": {
              "type": "object",
              "properties": {
                "items": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/store.Version"
                  }
                },
                "total": {
                  "type": "integer"
                }
              }
            }
          },
          "400": {
            "description": "namespace 非法",
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "缺少或无效的 X-API-Key",
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "key 的 namespace 与请求不符",
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "配置项不存在",
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "服务内部错误",
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/config/import": {
      "post": {
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "description": "批量原子导入配置条目：先全量门禁校验，任一条不过则整体不写。写面只认运维专用写 key。",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "tags": [
          "配置服务"
        ],
        "summary": "批量导入配置（运维写面）",
        "parameters": [
          {
            "description": "批量导入请求",
            "name": "request",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "entries": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "content_type": {
                        "type": "string"
                      },
                      "data_id": {
                        "type": "string"
                      },
                      "service_name": {
                        "type": "string"
                      },
                      "yaml_body": {
                        "type": "string"
                      }
                    }
                  }
                },
                "namespace": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "replace_existing": {
                  "type": "boolean"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "逐条导入结果（门禁失败/导入冲突亦为 200：整体不写，results[].ok=false + error_code/message）",
            "schema": {
              "type": "object",
              "properties": {
                "results": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/service.ImportOutcome"
                  }
                }
              }
            }
          },
          "400": {
            "description": "body 非法、namespace 非法或入参校验失败（entries 空/reason 缺失）",
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "缺少或无效的 X-API-Key",
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "非写 key 或 key 的 namespace 与请求不符",
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "服务内部错误",
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/config/revision": {
      "get": {
