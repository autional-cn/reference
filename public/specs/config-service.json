    "/config/rollback": {
      "post": {
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "description": "在单个 store 事务内把指定键回滚到目标 revision 的值，并作为新 revision 追加发布（不覆盖历史）。写面只认运维专用写 key。",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "tags": [
          "配置服务"
        ],
        "summary": "原子回滚配置（运维写面）",
        "parameters": [
          {
            "description": "回滚请求",
            "name": "request",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "app_id": {
                  "type": "string"
                },
                "environment": {
                  "type": "string"
                },
                "key": {
                  "type": "string"
                },
                "revision": {
                  "type": "integer"
                },
                "service_name": {
                  "type": "string"
                },
                "tenant_id": {
                  "type": "string"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "回滚后的配置项（新 revision，值为目标 revision 的值）",
            "schema": {
              "$ref": "#/definitions/store.Item"
            }
          },
          "400": {
            "description": "body 非法、namespace 非法或 revision 非正整数",
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "缺少或无效的 X-API-Key",
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "非写 key 或 key 的 namespace 与请求不符",
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "配置项不存在或目标 revision 不存在",
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "服务内部错误",
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/config/upsert": {
      "post": {
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "description": "写入单条配置项并生成新 revision；写面只认运维专用写 key。明文密钥门禁在 service 层强制执行。",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
