{
  "swagger": "2.0",
  "info": {
    "description": "Autional 配置中心服务：集中托管业务服务的非敏感配置，提供条目化读取、聚合读取、版本历史/回滚、upsert/delete/import 运维写面。读面共享读 key，写面仅运维专用写 key（X-API-Key）。",
    "title": "配置中心服务 API",
    "contact": {},
    "version": "1.0.0"
  },
  "basePath": "/api/v1",
  "paths": {
    "/config": {
      "get": {
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "description": "按 (namespace, service_name, data_id) 读取单条配置项。",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "tags": [
          "配置服务"
        ],
        "summary": "获取单条配置",
        "parameters": [
          {
            "type": "string",
            "description": "环境命名空间",
            "name": "namespace",
            "in": "query",
            "required": true
          },
          {
            "type": "string",
            "description": "服务名（空=全局默认）",
            "name": "service_name",
            "in": "query"
          },
          {
            "type": "string",
            "description": "配置项 key",
            "name": "data_id",
            "in": "query",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "配置项",
            "schema": {
              "$ref": "#/definitions/store.Item"
            }
          },
          "400": {
            "description": "namespace 非法",
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "缺少或无效的 X-API-Key",
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "key 的 namespace 与请求不符",
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "配置项不存在",
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "服务内部错误",
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/config/aggregated": {
      "get": {
        "security": [
          {
            "ApiKeyAuth": []
          }
