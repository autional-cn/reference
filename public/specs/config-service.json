          {
            "type": "string",
            "description": "服务名（空=全局默认）",
            "name": "service_name",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "合成的完整 YAML 文本",
            "schema": {
              "type": "string"
            }
