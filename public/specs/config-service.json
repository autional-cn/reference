          {
            "description": "批量读取请求",
            "name": "request",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "data_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "namespace": {
                  "type": "string"
                },
                "service_name": {
                  "type": "string"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "配置项列表",
            "schema": {
              "type": "object",
              "properties": {
                "items": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/store.Item"
                  }
                }
              }
            }
          },
          "400": {
            "description": "body 非法或 namespace 非法",
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "缺少或无效的 X-API-Key",
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "key 的 namespace 与请求不符",
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "存在缺失的配置项（整批失败）",
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "服务内部错误",
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/config/delete": {
      "post": {
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "description": "软删除单条配置项；写面只认运维专用写 key。",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "tags": [
          "配置服务"
        ],
        "summary": "删除配置（运维写面）",
        "parameters": [
          {
            "description": "删除请求",
            "name": "request",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "data_id": {
                  "type": "string"
                },
                "namespace": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "service_name": {
                  "type": "string"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "删除结果",
            "schema": {
              "type": "object",
              "properties": {
                "deleted": {
                  "type": "boolean"
                }
              }
            }
          },
          "400": {
            "description": "body 非法或 namespace 非法",
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "缺少或无效的 X-API-Key",
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer"
                },
