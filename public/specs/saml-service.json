    },
    "/saml/{provider_id}/slo/sp": {
      "get": {
        "description": "构建SAML LogoutRequest并重定向至IdP的SLO端点",
        "produces": [
          "application/json"
        ],
        "tags": [
          "SAML"
        ],
        "summary": "SP发起的SAML单点登出",
        "parameters": [
          {
            "type": "string",
            "description": "SAML Provider ID",
            "name": "provider_id",
            "in": "path",
            "required": true
          },
          {
            "type": "string",
            "description": "User ID",
            "name": "user_id",
            "in": "query",
            "required": true
          },
          {
            "type": "string",
            "description": "Session Index",
            "name": "session_index",
            "in": "query"
          }
        ],
        "responses": {
          "302": {
            "description": "重定向至IdP SLO端点"
