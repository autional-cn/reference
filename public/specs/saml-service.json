          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "tags": [
          "SAML 管理"
        ],
        "summary": "更新SAML IdP",
        "parameters": [
          {
            "type": "string",
            "description": "SAML IdP ID",
            "name": "provider_id",
            "in": "path",
            "required": true
          },
          {
            "description": "SAML IdP更新配置",
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
