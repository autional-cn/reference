        "summary": "删除SAML IdP",
        "parameters": [
          {
            "type": "string",
            "description": "SAML IdP ID",
            "name": "provider_id",
            "in": "path",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/dto.SimpleResponse"
            }
          }
        }
