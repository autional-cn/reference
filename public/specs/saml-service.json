    "/internal/saml/erase-user-links": {
      "post": {
        "description": "内部API：删除用户的所有SAML绑定（GDPR擦除，compliance-service 调用）。需InternalAPIKeyAuth认证。",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "tags": [
          "SAML - 内部接口"
        ],
        "summary": "擦除用户SAML绑定",
        "parameters": [
          {
            "description": "擦除请求",
            "name": "request",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/gitee_com_autional_service-saml_internal_handler_dto.EraseUserSamlLinksRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "擦除成功",
