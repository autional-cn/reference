        "produces": [
          "application/json"
        ],
        "tags": [
          "SAML"
        ],
        "summary": "断言消费服务",
        "parameters": [
          {
            "type": "string",
            "description": "SAML IdP ID",
            "name": "provider_id",
            "in": "path",
            "required": true
          },
          {
            "type": "string",
            "description": "Base64编码的SAML响应",
            "name": "SAMLResponse",
            "in": "formData",
            "required": true
          },
          {
            "type": "string",
            "description": "RelayState",
            "name": "RelayState",
            "in": "formData"
          }
