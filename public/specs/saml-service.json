          "application/json"
        ],
        "tags": [
          "SAML 管理"
        ],
        "summary": "列出SAML IdP",
        "parameters": [
          {
            "type": "integer",
            "default": 1,
            "description": "页码",
            "name": "page",
            "in": "query"
          },
          {
            "type": "integer",
            "default": 20,
            "description": "每页数量",
            "name": "page_size",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/gitee_com_autional_service-saml_internal_handler_dto.SamlProviderListDetailResponse"
            }
          }
        }
      },
      "post": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "注册一个新的SAML身份提供商配置",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "tags": [
          "SAML 管理"
        ],
        "summary": "注册SAML IdP",
        "parameters": [
          {
            "description": "SAML IdP配置",
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/gitee_com_autional_service-saml_internal_handler_dto.SamlProviderRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/gitee_com_autional_service-saml_internal_handler_dto.SamlProviderItemDetailResponse"
            }
          }
        }
      }
    },
