---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import RefLayout from '../layouts/RefLayout.astro';

export async function getStaticPaths() {
  const svcs = ["identity-service","profile-service","tenant-service","session-service","mfa-service","oauth-service","wallet-service","point-service","audit-service","notification-service","communication-service","storage-service","billing-service","compliance-service","status-service","secret-service","saml-service","pay-service","thirdparty-service","verification-service","rbac-service","gateway-service","hash-service-standard","hash-service-sm","captcha3d-service","config-service"];
  return svcs.map(n => ({ params: { service: n } }));
}

const { service } = Astro.params;

let specTitle = `${service} API 参考 — Autional`;
let specDescription = `${service} 的交互式 API 参考文档。`;
let endpointCount = 0;

try {
  const specPath = join(process.cwd(), 'public/specs', `${service}.json`);
  const spec = JSON.parse(readFileSync(specPath, 'utf-8'));
  specTitle = `${spec.info.title} — Autional`;
  specDescription = spec.info.description || `${service} 的交互式 API 参考文档，提供 OpenAPI 3.0 规范。`;

  const paths = spec.paths || {};
  for (const methods of Object.values(paths)) {
    if (typeof methods === 'object' && methods !== null) {
      endpointCount += Object.keys(methods).filter(k => k !== 'parameters').length;
    }
  }
} catch {
  // 回退到默认元信息
}
---

<RefLayout title={specTitle} description={specDescription} keywords={`Autional, API, ${service}, 接口参考, OpenAPI, Swagger`}>
  <div id="scalar-wrapper" class="flex-1 flex flex-col min-h-0" style="overflow:hidden">
    <div class="px-4 py-2 border-b border-neutral-100 bg-white flex items-center gap-2 text-xs">
      <span class="font-mono font-bold text-primary-600">{service}</span>
      <span class="text-neutral-300">|</span>
      <span class="text-neutral-500">{endpointCount} 个端点</span>
      <span class="text-neutral-300">|</span>
      <span class="text-neutral-400 font-mono text-[11px]">/bff/{service}/api/v1/</span>
    </div>
    <div
      id="api-reference"
      data-url={`/specs/${service}.json`}
      data-locale="zh-CN"
      data-theme="bluePlanet"
      data-layout="classic"
      data-show-side-bar="true"
      data-search-hotkey="k"
      style="min-height:0"
    >
    </div>
  </div>
  <script is:inline src="/scalar/api-reference.js"></script>
</RefLayout>
