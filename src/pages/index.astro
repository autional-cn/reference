---
import RefLayout from '../layouts/RefLayout.astro';
---

<RefLayout title="API 参考 — Autional" description="覆盖全部 22 个 Autional 微服务的交互式 OpenAPI 3.0 参考文档，基于 Scalar UI 浏览 1400+ REST 端点。">
  <div class="flex-1 flex items-center justify-center p-8">
    <div class="text-center max-w-sm">
      <h2 class="text-lg font-semibold text-neutral-400">请选择一个服务</h2>
      <p class="mt-2 text-sm text-neutral-300">在左侧列表中选择 →</p>
    </div>
  </div>
</RefLayout>
